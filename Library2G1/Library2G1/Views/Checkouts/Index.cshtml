@model IEnumerable<Library2G1.Models.Checkout>

@{
    ViewData["Title"] = "Index";
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["ErrorMessage"]
    </div>
}

<h1>Index</h1>

<form asp-action="Index" method="get">
    <div class="form-actions no-color">
        <p>
            Filter by Customer:
            <select name="searchCustId" asp-items="ViewBag.CustList" class="form-select">
                <option value="">--All--</option>
            </select>

            Filter by Book:
            <!-- class="form-select" will use the bootstrap version of the dropdown list (pretty!!) -->
            <select name="searchBookId" asp-items="ViewBag.BookList" class="form-select">
                <option value="">--All--</option>
            </select>

            <input type="submit" value="Search" class="btn btn-primary" />
            <a asp-action="Index">Clear Search</a>
        </p>
    </div>
</form>


<p>
    <a asp-action="Create">Create New</a>
</p>

@if (Model.Any() && Model != null) {
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.StartDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EndDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Book)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Customer)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.StartDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EndDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Book.BookTitle)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Customer.CustomerName)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.CheckoutId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.CheckoutId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.CheckoutId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

} else
{
    <p>
        Your selected search parameters returned no results, or the database is empty.
    </p>
}